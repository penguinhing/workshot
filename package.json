{
  "name": "workshot",
  "version": "0.0.2",
  "description": "Project state + DB snapshot/restore tool",
  "main": "./out/main/index.js",
  "author": "WorkShot",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "npm run build:bundle && electron-builder",
    "build:bundle": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "node scripts/run-electron-vite.mjs preview",
    "package": "npm run build:bundle && electron-builder --dir",
    "make": "npm run build"
  },
  "build": {
    "appId": "com.workshot",
    "productName": "WorkShot",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "files": [
      "out/**",
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsx",
      "!**/*.d.ts",
      "!**/*.d.cts",
      "!**/*.d.mts",
      "!**/README*",
      "!**/CHANGELOG*",
      "!**/HISTORY*",
      "!**/docs/**",
      "!**/doc/**",
      "!**/example/**",
      "!**/examples/**",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      "!**/coverage/**"
    ],
    "afterPack": "scripts/patch-exe-icon.cjs",
    "extraResources": [
      "icon.ico"
    ],
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "electron-store": "^8.2.0",
    "tar-stream": "^3.1.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/tar-stream": "^3.1.3",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resedit": "^1.7.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
